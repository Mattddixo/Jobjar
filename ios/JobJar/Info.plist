<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Launch screen: the app icon on the app's page colour. Everything else in the Info.plist
	     is generated from the INFOPLIST_KEY_ settings in project.yml. -->
	<!-- jobjar://job/<id>: the link on calendar events opens that job. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mattdixon.jobjar</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jobjar</string>
			</array>
		</dict>
	</array>
		<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
</dict>
</plist>
