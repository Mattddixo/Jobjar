<?xml version="1.0" encoding="utf-8"?>
<!-- Draw a job: the drawn job (or a prompt) above a Draw button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/draw_job"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_job_background"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/draw_title"
            android:text="@string/widget_draw_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_on_honey"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/draw_detail"
            android:text="@string/widget_draw_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_honey"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/draw_button"
        android:text="@string/widget_draw"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:textColor="@color/widget_on_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
